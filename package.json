{
  "name": "baby-name-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Explorer des milliers de prénoms et constituer sa shortlist à deux.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/postbuild.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "build:names": "tsx scripts/build-names.ts",
    "check:repo": "tsx scripts/check-repo.ts",
    "clean": "rimraf dist coverage",
    "prepare": "husky",
    "secrets:github": "tsx scripts/set-github-secrets.ts",
    "pages:enable": "tsx scripts/enable-github-pages.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "libsodium-wrappers": "^0.7.16",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
